{
	"name": "kernowdev/clanbite",
	"description": "Community management system for gamers and sports teams plugin for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"classmap": [
			"clanbite.php",
			"inc/"
		],
		"psr-4": {
			"Kernowdev\\Clanbite\\": "inc/"
		},
		"files": [
			"inc/extensions/notifications/functions.php",
			"inc/extensions/events/functions.php",
			"inc/extensions/players/functions.php",
			"inc/extensions/teams/functions.php",
			"inc/groups/functions.php",
			"inc/class-block-patterns.php",
			"inc/functions-wordban.php",
			"inc/functions-block-templates.php",
			"inc/functions-request-input.php",
			"inc/functions-country-flags.php",
			"inc/functions-block-entity-link.php",
			"inc/profile-subpages.php",
			"inc/visibility-container.php",
			"inc/avatar-helpers.php",
			"inc/clanbite-wp-admin-includes.php",
			"inc/clanbite-private-media.php",
			"inc/clanbite-team-challenge-uploads.php",
			"inc/clanbite-block-render-escape.php",
			"build/shared/components/avatar-progress-bar.php",
			"build/shared/components/avatar-rank-icon.php",
			"shortcut-function.php"
		]
	},
	"authors": [
		{
			"name": "kernowdev",
			"email": "wasson@kernow.dev"
		}
	],
	"minimum-stability": "dev",
	"require-dev": {
		"php-stubs/wordpress-stubs": "^6.8",
		"phpcompatibility/phpcompatibility-wp": "dev-master",
		"phpstan/phpstan": "^2.1",
		"squizlabs/php_codesniffer": "3.x-dev",
		"wp-coding-standards/wpcs": "dev-develop"
	},
	"scripts": {
		"lint:php": "phpcs",
		"lint:php:fix": "phpcbf",
		"phpstan": "phpstan analyse --memory-limit=1024M"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
